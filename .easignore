# EAS uses this instead of .gitignore. Keep the shared exclusions in sync.
/.git
node_modules/
.expo/
dist/
.npm-cache/
test-results/
verification/
*.tsbuildinfo
.env*
!.env.example
expo-env.d.ts

# Keep native source, Gradle wrapper and resources; rebuild all local products.
/android/**/build/
/android/**/.cxx/
/android/.gradle/
/android/.kotlin/
/android/local.properties
/android/captures/
/ios/build/
/ios/Pods/
**/DerivedData/
**/xcuserdata/
*.hprof
.DS_Store

# Local previews, authoring references and editor configuration.
/.claude/
/.vscode/
/mock/
/docs/
/ART-PROMPTS*.json
/AGENTS.md
/CLAUDE.md
/README.md
# Regenerated by the existing postinstall script from the installed Skia version.
/public/canvaskit.wasm

# Superseded artwork and unused starter assets. Runtime assets stay included.
/assets/expo.icon/
/assets/images/
