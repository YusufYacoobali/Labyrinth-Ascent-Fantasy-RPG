{
  "expo": {
    "name": "Labyrinth Awaits",
    "slug": "labyrinth-awaits",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "labyrinthawaits",
    "userInterfaceStyle": "dark",
    "icon": "./assets/art/icon.png",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080f19",
        "foregroundImage": "./assets/art/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "name": "Labyrinth Awaits",
      "favicon": "./assets/art/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080f19",
          "image": "./assets/art/icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
